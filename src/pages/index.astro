---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="stylesheet" href="/live2d/pio.css" />
	</head>
	<body>
		<Header />
		
		<main>
			<h1>Welcome to Romuda's night.</h1>
			<p>
				这是我的个人博客，用于记录一些杂乱无章的随笔以及CS被拷打的历程。
			</p>
			<p class="strikethrough-blue">（其实都是胡言乱语罢了）</p>
			
			<div class="source-code-wrapper">
				<span class="credit-text">CSS provided by Gemini & Romuda</span>
				<a href="https://github.com/fk-cmn/romuda-astro-blog" target="_blank" class="source-btn">
					<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
						<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
					</svg>
					<span>Website Source</span>
				</a>
			</div>
		</main>

		<style>
			/* =================================================== */
			/* 底部源码按钮及小字样式 (浅色胶囊版) */
			/* =================================================== */
			.source-code-wrapper {
				display: flex;
				flex-direction: column;
				align-items: center; /* 强制居中 */
				justify-content: center;
				margin-top: 3.5rem;  /* 距离上方正文的间距 */
				margin-bottom: 2rem;
				gap: 0.8rem;         /* 小字和按钮之间的间距 */
				width: 100%;         /* 撑满父容器以确保居中 */
			}

			.credit-text {
				font-size: 0.85rem;
				color: rgba(255, 255, 255, 0.6); /* 稍微调亮一点，防止太暗看不见 */
				letter-spacing: 1px;
				font-family: monospace; 
			}

			.source-btn {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				padding: 10px 26px; /* 增加一点内边距，让胶囊更舒展 */
				background: rgba(255, 255, 255, 0.9); /* 浅色/近乎白色的背景 */
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border: 1px solid rgba(255, 255, 255, 1);
				border-radius: 50px; /* 完美的胶囊圆角 */
				color: #0f1c2e;      /* 深蓝色文字，对比度极高 */
				text-decoration: none;
				font-size: 0.95rem;
				font-weight: 700;    /* 字体加粗更醒目 */
				box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2); /* 默认有一点柔和的阴影 */
				transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
			}

			/* 鼠标悬停时的特效 */
			.source-btn:hover {
				background: #ffffff;
				color: #2337ff; /* 悬停时文字变成你全局的那个亮蓝色 */
				box-shadow: 0 6px 20px rgba(35, 55, 255, 0.4); /* 蓝色发光特效 */
				transform: translateY(-3px); /* 悬停时上浮 */
			}
		</style>

		<Footer />
		
		<div class="pio-container left">
			<div class="pio-action"></div>
			<canvas id="pio"></canvas>
		</div>

		<script is:inline src="/live2d/live2dcubismcore.min.js"></script>
		<script is:inline src="/live2d/pixi.min.js"></script>
		<script is:inline src="/live2d/cubism4.min.js"></script>
		<script is:inline src="/live2d/pio.js"></script>
		<script is:inline src="/live2d/pio_sdk4.js"></script>
		<script is:inline src="/live2d/load.js"></script>
	</body>
</html>