---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	    <link rel="stylesheet" href="/live2d/pio.css" />
</head>
	</head>
	<body>
		<Header />
		<main>
			<h1>Welcome to Romuda's night.</h1>
			<p>
				这是我的个人博客，用于记录一些杂乱的知识以及被拷打的历程。
			</p>
			<p class="strikethrough-blue">（其实都是胡言乱语罢了）</p>
			
			
			
			
		</main>
		<Footer />
		<div class="pio-container left">
        <div class="pio-action"></div>
        <canvas id="pio"></canvas>
    </div>

    <script is:inline src="/live2d/live2dcubismcore.min.js"></script>
    <script is:inline src="/live2d/pixi.min.js"></script>
    <script is:inline src="/live2d/cubism4.min.js"></script>
    <script is:inline src="/live2d/pio.js"></script>
    <script is:inline src="/live2d/pio_sdk4.js"></script>
    <script is:inline src="/live2d/load.js"></script>
	</body>
</html>
