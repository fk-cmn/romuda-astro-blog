---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const latestPost = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="stylesheet" href="/live2d/pio.css" />
		<link rel="preload" href="/fonts/great-vibes-regular.ttf" as="font" type="font/ttf" crossorigin />
	</head>
	<body class="home-page">
		<Header />
		<div class="background-view">
			<h1 class="hero-title">Welcome to Romuda's World</h1>
			<a class="scroll-hint" href="#home-content" aria-label="向下滚动，查看首页内容">
				<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
		</div>
		
		<main id="home-content">
			<div class="glass-card">
				<p class="desc-text">这是我的个人博客，用于记录一些杂乱无章的随笔以及CS被拷打的历程。</p>
				<p class="desc-text"><del>（其实都是胡言乱语罢了）</del></p>
			</div>
			
			<div class="source-code-wrapper">
				<span class="credit-text">CSS provided by Gemini & Romuda</span>
				<a href="https://github.com/fk-cmn/romuda-astro-blog" target="_blank" class="source-btn">
					<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
						<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
					</svg>
					<span>Website Source</span>
				</a>
			</div>
		</main>

		<style>
			@font-face {
				font-family: 'Great Vibes';
				src: url('/fonts/great-vibes-regular.ttf') format('truetype');
				font-style: normal;
				font-weight: 400;
				font-display: swap;
			}
			:global(body.home-page) {
				margin: 0;
			}
			:global(body.home-page .header-glass) {
				position: fixed;
				left: 0;
				right: 0;
			}
			.background-view {
				position: relative;
				height: 100vh;
				height: 100svh;
			}
			.hero-title {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				box-sizing: border-box;
				width: 100%;
				max-width: 1440px;
				margin: 0;
				padding: 0 1.5rem;
				font-family: 'Great Vibes', 'Segoe Script', cursive;
				font-size: clamp(2.8rem, 7vw, 6.5rem);
				font-weight: 400;
				line-height: 1.35;
				text-align: center;
				text-wrap: balance;
				color: #fff;
				text-shadow: 0 3px 16px rgba(0, 25, 20, 0.75), 0 1px 4px rgba(0, 0, 0, 0.5);
			}
			main {
				scroll-margin-top: 110px;
				margin: 2rem auto;
			}
			.scroll-hint {
				position: absolute;
				bottom: 24px;
				left: 50%;
				transform: translateX(-50%);
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 4px;
				padding: 8px 16px;
				color: #ffffff;
				text-decoration: none;
				font-size: 0.8rem;
				letter-spacing: 2px;
				text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
				border-radius: 12px;
			}
			.scroll-hint:hover,
			.scroll-hint:focus-visible {
				color: #00ffff;
				background: rgba(8, 42, 34, 0.28);
			}
			.scroll-hint:focus-visible {
				outline: 2px solid #00ffff;
				outline-offset: 4px;
			}
			.source-code-wrapper { display: flex; flex-direction: column; align-items: center; justify-content: center; margin-top: 3.5rem; margin-bottom: 2rem; gap: 0.8rem; width: 100%; }
			.credit-text { font-size: 0.85rem; color: rgba(255, 255, 255, 0.6); letter-spacing: 1px; font-family: monospace; }
			.source-btn { display: flex; align-items: center; gap: 0.6rem; padding: 10px 26px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 1); border-radius: 50px; color: #0f1c2e; text-decoration: none; font-size: 0.95rem; font-weight: 700; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2); transition: 0.3s; }
			.source-btn:hover { background: #ffffff; color: #2337ff; box-shadow: 0 6px 20px rgba(35, 55, 255, 0.4); transform: translateY(-3px); }
			.desc-text { text-align: center; }
		</style>

		<Footer />
		
		<div
			id="pio-container"
			class="pio-container left"
			data-latest-title={latestPost?.data.title ?? ''}
		>
			<div class="pio-action" style="display: none !important;"></div>
			<canvas id="pio"></canvas>
		</div>

		<script is:inline src="/live2d/live2dcubismcore.min.js"></script>
		<script is:inline src="/live2d/pixi.min.js"></script>
		<script is:inline src="/live2d/cubism4.min.js"></script>
		<script is:inline src="/live2d/pio.js"></script>
		<script is:inline src="/live2d/pio_sdk4.js"></script>
		<script is:inline src="/live2d/load.js"></script>

	</body>
</html>
