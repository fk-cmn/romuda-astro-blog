---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: { depth: number; slug: string; text: string }[];
};

const { title, description, pubDate, updatedDate, heroImage, headings } = Astro.props;

// ====== 终极双保险：同时判断 URL 和 标题，确保绝对命中 About 页面 ======
const isAboutPage = title === 'About' || title === 'About Me' || Astro.url.pathname.includes('about');
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style is:global>
			/* =================================================== */
			/* 1. 基础骨架容器（保持居中和加宽） */
			/* =================================================== */
			main {
				width: calc(100% - 2em) !important;
				max-width: 900px !important;
				margin: 0 auto !important;
			}

			/* =================================================== */
			/* 2. 博客专属：硬核纯白毛玻璃 */
			/* =================================================== */
			main.blog-white-theme {
				background: rgba(255, 255, 255, 0.92) !important; 
				backdrop-filter: blur(16px) saturate(180%);
				-webkit-backdrop-filter: blur(16px) saturate(180%);
				border: 1px solid rgba(255, 255, 255, 0.6); 
				box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.15); 
				border-radius: 16px;
				padding: 3em 2em;
				color: #1a1f26 !important; 
			}

			/* 博客文章的深色文字和高亮 */
			main.blog-white-theme h1, main.blog-white-theme h2, main.blog-white-theme h3, main.blog-white-theme h4, main.blog-white-theme h5, main.blog-white-theme h6 {
				color: #0f141c !important;
				text-shadow: none !important;
				margin-top: 1.5em;
				margin-bottom: 0.6em;
			}
			main.blog-white-theme p, main.blog-white-theme li {
				color: #242930 !important;
			}
			main.blog-white-theme :not(pre) > code {
				background: rgba(0, 0, 0, 0.06) !important;
				color: #eb5757 !important;
				font-size: 1.05em !important; 
				padding: 0.2rem 0.5rem !important;
				margin: 0 2px !important;
				border-radius: 4px;
				font-family: monospace;
			}
			main.blog-white-theme blockquote {
				background: rgba(0, 0, 0, 0.03) !important;
				border-left: 4px solid #2337ff !important;
				padding: 0.5em 1em !important; 
				margin: 0.8em 0 !important; 
				border-radius: 0 6px 6px 0;
			}
			main.blog-white-theme blockquote p {
				color: #556375 !important;
				font-style: italic;
				font-size: 0.95em !important; 
				margin: 0 !important;
			}

			/* =================================================== */
			/* 3. 新增！About 页面专属：高级暗黑透光毛玻璃 */
			/* =================================================== */
			main.about-dark-theme {
				background: rgba(0, 0, 0, 0.35) !important; /* 低调的暗黑半透明，完美融合图片光影 */
				backdrop-filter: blur(12px) saturate(150%);
				-webkit-backdrop-filter: blur(12px) saturate(150%);
				border: 1px solid rgba(255, 255, 255, 0.1); 
				box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
				border-radius: 16px;
				padding: 3em 2em;
				color: #e0e0e0 !important; /* 字体变成亮色，在深色背景下清晰可见 */
			}
			
			/* About 页面的大标题变成纯白加微弱发光 */
			main.about-dark-theme h1, main.about-dark-theme h2, main.about-dark-theme h3 {
				color: #ffffff !important;
				text-shadow: 0 2px 8px rgba(0,0,0,0.8) !important;
			}

			/* =================================================== */
			/* 4. 侧边栏与正文布局（保持原样） */
			/* =================================================== */
			.content-wrapper {
				display: flex;
				gap: 3rem; 
				align-items: flex-start; 
				margin-top: 2rem;
			}
			.prose {
				flex: 1; 
				min-width: 0; 
			}
			.toc {
				width: 240px; 
				flex-shrink: 0;
			}
			.toc-sticky {
				position: sticky;
				top: 6rem; 
				max-height: calc(100vh - 8rem); 
				overflow-y: auto; 
				padding-left: 1.5rem;
				border-left: 2px solid rgba(0, 0, 0, 0.08); 
			}
			.toc-sticky h4 {
				margin-top: 0;
				font-size: 1.1rem;
				color: #0f141c !important;
				letter-spacing: 2px;
			}
			.toc-sticky ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.toc-sticky li {
				margin-bottom: 0.4rem;
			}
			.toc-sticky a {
				display: block;
				color: #556375 !important;
				text-decoration: none;
				font-size: 0.9rem;
				line-height: 1.4;
				transition: all 0.2s ease;
			}
			.toc-sticky a:hover {
				color: #2337ff !important; 
				transform: translateX(4px); 
			}
			.toc-level-1, .toc-level-2 { font-weight: 600; margin-top: 0.8rem; }
			.toc-level-3 { margin-left: 1rem; font-size: 0.85rem; }
			.toc-level-4 { margin-left: 2rem; font-size: 0.8rem; }
			@media (max-width: 1024px) {
				.content-wrapper { flex-direction: column-reverse; } 
				.toc { width: 100%; }
				.toc-sticky {
					position: static;
					max-height: none;
					border-left: none;
					padding-left: 0;
					border-bottom: 1px solid rgba(0,0,0,0.08);
					padding-bottom: 1.5rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		
		<main class={isAboutPage ? "about-dark-theme" : "blog-white-theme"}>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="title">
					<div class="date">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<div class="last-updated-on">
								Last updated on <FormattedDate date={updatedDate} />
							</div>
						)}
					</div>
					<h1>{title}</h1>
					<hr />
				</div>
				
				<div class="content-wrapper">
					<div class="prose">
						<slot />
					</div>

					{!isAboutPage && headings && headings.length > 0 && (
						<aside class="toc">
							<div class="toc-sticky">
								<h4>目录</h4>
								<ul>
									{headings.map((heading) => (
										<li class={`toc-level-${heading.depth}`}>
											<a href={`#${heading.slug}`}>{heading.text}</a>
										</li>
									))}
								</ul>
							</div>
						</aside>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>